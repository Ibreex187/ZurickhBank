<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Welcome to Banknode</title>
		<style>
			body { font-family: Arial, sans-serif; color: #333; }
			.container { max-width:600px; margin:20px auto; padding:20px; border:1px solid #eee; }
			.footer { font-size:12px; color:#777; margin-top:20px }
		</style>
	</head>
	<body>
		<div class="container">
			<h2>Welcome to Zurich Bank, <%= name || username %>!</h2>
			<p>Hi <strong><%= name || username %></strong>,</p>
			<p>Thank you for creating an account with Zurich Bank. We're delighted to have you on board.</p>

			<% if (accountNumber) { %>
				<p>Your account number: <strong><%= accountNumber %></strong></p>
			<% } %>

			<p>If you need help, contact us at <a href="mailto:<%= supportEmail || 'support@ZurichBank.example' %>"><%= supportEmail || 'support@ZurichBank.example' %></a>.</p>

			<p>— The Zurich Bank Team</p>

			<div class="footer">This is an automated message. Please do not reply to this email.</div>
		</div>
	</body>
</html>
